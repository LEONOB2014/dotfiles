# Personal Ghostty config — maintained by Andrés Becerra with Claude (Anthropic)
# Catppuccin Mocha theme, matching the tmux and starship packages

# Font & appearance
font-family = "JetBrainsMono Nerd Font"
font-size = 16
theme = "Catppuccin Mocha"
cursor-style = block
cursor-style-blink = false
background-opacity = 0.95
# macos-titlebar-style = transparent


# Performance & behavior
window-padding-x = 8
window-padding-y = 4
scrollback-limit = 100000
copy-on-select = false
clipboard-read = allow
clipboard-write = allow
shell-integration = zsh

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Navigate between splits
keybind = cmd+opt+arrow_left=goto_split:left
keybind = cmd+opt+arrow_right=goto_split:right
keybind = cmd+opt+arrow_up=goto_split:top
keybind = cmd+opt+arrow_down=goto_split:bottom

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab

# Quality of life for agents
confirm-close-surface = false
macos-option-as-alt = true 
